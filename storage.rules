rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /videos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }
    match /thumbnails/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /liveCovers/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Raw, unprocessed clips a creator records/imports while editing —
    // input to the onVideoJobCreate Cloud Function (see functions/src/video.ts).
    match /rawClips/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 300 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Music/voiceover audio a creator attaches to an edit before it's
    // processed into the final video.
    match /soundUploads/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 50 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');
    }

    // Final rendered output of a video-processing job — written only by
    // the Cloud Function (Admin SDK bypasses these rules entirely).
    match /processedVideos/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
