{
  "expo": {
    "name": "FLIXA",
    "slug": "FLIXA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050509",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flixa.app"
    },
    "android": {
      "package": "com.flixa.app",
      "adaptiveIcon": {
        "backgroundColor": "#050509",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Flixa needs access to your photo library so you can post a video.",
          "cameraPermission": "Flixa needs access to your camera so you can record a video.",
          "microphonePermission": "Flixa needs access to your microphone to record audio with your video."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flixa needs access to your camera so you can record a video.",
          "microphonePermission": "Flixa needs access to your microphone to record audio with your video."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ]
  }
}
