{
  "expo": {
    "name": "FLIXA",
    "slug": "FLIXA",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050509",
    "ios": {
      "supportsTablet": true,
      "bitcode": false,
      "bundleIdentifier": "com.beingtn.FLIXA",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.beingtn.FLIXA",
      "adaptiveIcon": {
        "backgroundColor": "#050509",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Flixa needs access to your photo library so you can post a video.",
          "cameraPermission": "Flixa needs access to your camera so you can record a video.",
          "microphonePermission": "Flixa needs access to your microphone to record audio with your video."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Flixa needs access to your camera so you can record a video.",
          "microphonePermission": "Flixa needs access to your microphone to record audio with your video."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "91de4593-6a3a-421d-8d70-94f18f78b1fc"
      }
    }
  }
}