rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- This app's video posts ----
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount']);
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;

      match /likes/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      }
    }

    // ---- Shared user profiles (both apps read/write this collection) ----
    match /users/{uid} {
      allow read: if true;
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']);

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }

      match /following/{followingUid} {
        allow read: if true;
        allow write: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if true;
        allow write: if isOwner(followerUid);
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(uid);
      }

      match /savedVideos/{videoId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- This app's messaging ----
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---- Other app's wallet (server/Cloud Functions only) ----
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- Other app's live streaming ----
    match /liveStreams/{streamId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    // ---- Other app's videos collection (separate from this app's posts) ----
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if isOwner(resource.data.uploaderId);
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount']);

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid);
        allow update: if false;
      }
    }

    match /exploreHashtags/{hashtagId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /exploreCreators/{creatorId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']);
      allow create, delete: if false;

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(followerId);
        allow update, delete: if false;
      }
    }
  }
}
