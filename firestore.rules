rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        // Any signed-in user may drop a notification into someone else's
        // inbox (the client-side equivalent of a like/comment/follow event);
        // only the inbox owner may mark it read or delete it.
        allow create: if isSignedIn();
        allow update, delete: if isOwner(uid);
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(uid);
      }

      match /savedVideos/{videoId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Wallet balances and transactions are server-authoritative: every
    // credit/debit happens in a Cloud Function via the Admin SDK, which
    // bypasses these rules. Clients may only read their own wallet.
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    match /liveStreams/{streamId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update, delete: if false;
      }
    }

    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if isOwner(resource.data.uploaderId);
      // likeCount/commentCount are server-authoritative (Cloud Function
      // triggers on the likes/comments subcollections below); shareCount is
      // a low-stakes vanity counter the client may bump directly.
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount']);

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid);
        allow update: if false;
      }
    }

    match /exploreHashtags/{hashtagId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /exploreCreators/{creatorId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']);
      allow create, delete: if false;

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(followerId);
        allow update, delete: if false;
      }
    }
  }
}
