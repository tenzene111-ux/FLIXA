rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---- Video posts (likeCount/commentCount are server-authoritative,
    // updated by Cloud Function triggers in functions/src/index.ts —
    // clients may only bump shareCount/viewCount directly, since neither
    // is security- or money-sensitive) ----
    match /videos/{videoId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderId == request.auth.uid;
      allow delete: if isOwner(resource.data.uploaderId);
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareCount', 'viewCount']);

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(uid);
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid);
        allow update: if false;
      }

      // One vote doc per user (doc id = uid); no update allowed, so a vote
      // can't be changed or double-cast once set.
      match /pollVotes/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid) && request.resource.data.optionId is string;
        allow update, delete: if false;
      }

      // Gift records back a per-video leaderboard. Only the sendGift Cloud
      // Function (Admin SDK, bypasses these rules) may write one, so every
      // entry here is tied to a real coin/diamond transfer.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // ---- Shared user profiles ----
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']);

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if isSignedIn();
      }

      match /following/{followingUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      match /followers/{followerUid} {
        allow read: if isSignedIn();
        allow write: if isOwner(followerUid);
      }

      match /playlists/{playlistId} {
        allow read, write: if isOwner(uid);
      }

      match /savedVideos/{videoId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---- Messaging ----
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create: if isSignedIn()
          && request.resource.data.senderUid == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /analytics_events/{eventId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ---- Wallet (server-authoritative — every credit/debit runs through a
    // Cloud Function callable via the Admin SDK; clients may only read) ----
    match /wallets/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ---- Live streaming ----
    match /liveStreams/{streamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow delete: if isOwner(resource.data.hostUid);
      // Two different actors can update this doc, for two different
      // non-overlapping field sets: the host controls stream config, any
      // signed-in viewer may only bump the low-stakes likeCount. Viewer
      // count is derived client-side from the viewers subcollection below,
      // never stored as a trusted field here.
      allow update: if isSignedIn() && (
        (isOwner(resource.data.hostUid) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['isLive', 'title', 'coverUrl', 'category', 'hashtags', 'allowComments', 'allowGifts', 'pinnedMessage', 'goalTarget', 'highlightedQuestionId', 'battle']))
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );

      // A comment can be removed by its author, the host, or a moderator
      // (moderator status is just membership in the moderators
      // subcollection below — checked with get(), same pattern already
      // used for the host-only poll/question rules). A blocked viewer
      // can't post at all.
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.uid == request.auth.uid
          && !exists(/databases/$(database)/documents/liveStreams/$(streamId)/blockedUsers/$(request.auth.uid));
        allow delete: if isOwner(resource.data.uid)
          || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid)
          || exists(/databases/$(database)/documents/liveStreams/$(streamId)/moderators/$(request.auth.uid));
        allow update: if false;
      }

      // Presence: each viewer owns exactly one doc (id = uid), created on
      // join and deleted on leave, so a live viewer count is just this
      // subcollection's size.
      match /viewers/{uid} {
        allow read: if isSignedIn();
        allow write: if isOwner(uid);
      }

      // Moderators are appointed/removed by the host only; membership here
      // is what the comments/blockedUsers rules above check with get().
      match /moderators/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
        allow update: if false;
      }

      // A blocked viewer can still watch, just can't post comments (see
      // the comments rule above) — host or any moderator can block/unblock.
      match /blockedUsers/{uid} {
        allow read: if isSignedIn();
        allow create, delete: if isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid)
          || exists(/databases/$(database)/documents/liveStreams/$(streamId)/moderators/$(request.auth.uid));
        allow update: if false;
      }

      // A viewer requests to go on-stage as a guest by creating their own
      // pending doc; only the host may accept/reject it (status is the
      // only field they may change). The requester or the host can cancel
      // it outright.
      match /guestRequests/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(uid) && request.resource.data.status == 'pending';
        allow update: if isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
        allow delete: if isOwner(uid)
          || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
      }

      // Co-hosts are added only by the host accepting a guest request
      // (this is also what getLiveKitToken checks server-side before
      // minting a publish-capable token — see functions/src/index.ts). A
      // co-host can remove themselves; the host can remove anyone.
      match /coHosts/{uid} {
        allow read: if isSignedIn();
        allow create: if isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
        allow delete: if isOwner(uid)
          || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
        allow update: if false;
      }

      // Same pattern as videos/{id}/gifts: only the sendGift Cloud
      // Function may write one.
      match /gifts/{giftId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      // A live poll is its own doc so the host can run several across one
      // broadcast without losing history; only the host may create/end one.
      match /polls/{pollId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
        allow delete: if false;

        // One vote doc per user; no update, so a vote can't change or be
        // double-cast.
        match /votes/{uid} {
          allow read: if isSignedIn();
          allow create: if isOwner(uid) && request.resource.data.optionId is string;
          allow update, delete: if false;
        }
      }

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isOwner(resource.data.uid)
          || isOwner(get(/databases/$(database)/documents/liveStreams/$(streamId)).data.hostUid);
        allow update: if false;

        // One upvote doc per user; no update, so it can't be double-cast.
        match /upvotes/{uid} {
          allow read: if isSignedIn();
          allow create, delete: if isOwner(uid);
          allow update: if false;
        }
      }
    }

    // ---- Curated explore content (admin/seed-managed) ----
    match /exploreHashtags/{hashtagId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /exploreCreators/{creatorId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount']);
      allow create, delete: if false;

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isOwner(followerId);
        allow update, delete: if false;
      }
    }
  }
}
